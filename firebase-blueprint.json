{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "Client record with contact, project, and payment details",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "companyName": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 200 },
        "projectName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "fullPayment": { "type": "number" },
        "advancePayment": { "type": "number" },
        "remainingPayment": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["Pending", "Partially Paid", "Fully Paid"] },
        "projectStatus": { "type": "string", "enum": ["Inquiry", "Confirmed", "In Progress", "Completed", "Cancelled"] },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "projectName", "fullPayment", "advancePayment", "remainingPayment", "paymentStatus", "projectStatus"]
    },
    "CmsContent": {
      "title": "CmsContent",
      "description": "Global CMS content for website sections including gallery, hero, videos, testimonials, and settings",
      "type": "object",
      "properties": {
        "gallery": { "type": "array" },
        "testimonials": { "type": "array" },
        "settings": { "type": "object" },
        "heroSlides": { "type": "array" },
        "heroConfig": { "type": "object" },
        "videos": { "type": "array" },
        "updatedAt": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Collection of client project management and payment tracking records"
    },
    "/cms_content/{docId}": {
      "schema": { "$ref": "#/entities/CmsContent" },
      "description": "Global CMS website configuration and section records"
    }
  }
}
