rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny for unhandled documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Clients collection - enabled for real-time CRM updates across devices
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // CMS Content collection - allows real-time website updates & CMS sync across devices
    match /cms_content/{docId} {
      allow read, write: if true;
    }
  }
}

